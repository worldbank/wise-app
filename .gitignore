# Everything is tracked unless ignored here. Each section says why.
# To keep a file that a pattern below ignores, add a "!" line after it.

# Operating system and editors
.DS_Store
Thumbs.db
.Rproj.user/
.Rhistory
.RData
.Ruserdata
.vscode/
.idea/
.posit/
__pycache__/
*.pyc

# Secrets and credentials. Never commit these.
.env
.env.*
!.env.example
.Renviron
password.*
passwords.*
password/
passwords/
token.*
tokens.*
token/
tokens/
rsconnect/

# Local agent and tool state
.kilo/
# .claude/ holds local state and the link to the shared skills folder
# (.agents/skills, see README). Only a shared settings.json would be tracked.
.claude/*
!.claude/settings.json

# Build artifacts
# man/ is generated by devtools::document() and not tracked; CI documents
# before it checks (.github/workflows/R-CMD-check.yaml).
man/
src/*.o
src/*.so
src/*.dll
# Uncompressed DuckDB extension binaries stay untracked; the .gz versions in
# inst/duckdb_extensions/ are committed because Posit Connect loads them at
# runtime through system.file() (R/fct_load_data.R).
*.duckdb_extension

# Run outputs and test artifacts
dev/outputs/
dev/output/
tests/e2e/out/
tests/testthat/testthat-problems.rds
_targets/
*.log

# Data and binary files. Raw and produced datasets are never committed.
*.parquet
*.csv
*.qs
*.qs2
*.rds
*.RDS
*.rda
*.RData
*.dta
*.xls
*.xlsx
*.zip
*.duckdb
*.db
*.sqlite
*.feather
*.arrow

# Rendered reports, design sketches and images
*.html
*.pdf
*.png
*.jpg
*.jpeg
# App assets that must be committed (the page cannot render without them)
!inst/app/www/*.png
